<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyWeather" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
    </style>

    <style name="Theme.MyWeather.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dark_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/img_white</item>
        <item name="postSplashScreenTheme">@style/Theme.MyWeather</item>
    </style>

</resources>